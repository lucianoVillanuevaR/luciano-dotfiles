* {
  bg: rgba(5, 5, 5, 78%);
  bg-alt: rgba(15, 15, 15, 74%);
  fg: #f0f0f0;
  muted: #a0a0a0;
  border: rgba(255, 255, 255, 12%);
  active: rgba(255, 255, 255, 14%);
  urgent: #f7768e;

  background-color: transparent;
  text-color: @fg;
}

window {
  width: 42%;
  border: 1px;
  border-color: @border;
  border-radius: 10px;
  background-color: @bg;
}

mainbox {
  padding: 12px;
  spacing: 10px;
}

inputbar {
  padding: 10px;
  border-radius: 9px;
  background-color: @bg-alt;
  children: [prompt, entry];
}

prompt {
  text-color: @fg;
  padding: 0 8px 0 0;
}

entry {
  placeholder: "Buscar";
  placeholder-color: @muted;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: true;
  spacing: 4px;
}

element {
  padding: 9px 10px;
  border-radius: 9px;
}

element selected {
  background-color: @active;
  text-color: @fg;
}

element-icon {
  size: 22px;
  margin: 0 10px 0 0;
}

element-text {
  vertical-align: 0.5;
}
