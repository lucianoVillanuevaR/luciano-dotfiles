{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/spotify", "network", "pulseaudio", "battery"],

  "hyprland/workspaces": {
    "format": "{name}"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 70,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "custom/spotify": {
    "exec": "playerctl -p spotify_player metadata --format '♫ {{artist}} - {{title}}' 2>/dev/null || true",
    "exec-if": "playerctl -p spotify_player status 2>/dev/null | grep -q '^Playing$'",
    "interval": 2,
    "return-type": "text",
    "max-length": 34,
    "on-click": "playerctl -p spotify_player play-pause",
    "on-click-right": "playerctl -p spotify_player next",
    "on-click-middle": "playerctl -p spotify_player previous",
    "on-scroll-up": "playerctl -p spotify_player next",
    "on-scroll-down": "playerctl -p spotify_player previous"
  },

  "network": {
    "format-wifi": "WiFi",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format-wifi": "{essid}: {signalStrength}% ({ifname})",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Sin conexion"
  },

  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{desc}"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}% +",
    "format-plugged": "{capacity}% AC",
    "format-alt": "{time}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  }
}
