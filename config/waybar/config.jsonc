{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["custom/spotify", "clock"],
  "modules-right": ["cpu", "memory", "temperature", "network", "pulseaudio", "battery"],

  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": 9
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 70,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "custom/spotify": {
    "exec": "playerctl -p spotify_player metadata --format '♫ {{artist}} - {{title}}' 2>/dev/null || true",
    "interval": 2,
    "return-type": "text",
    "max-length": 42,
    "on-click": "playerctl -p spotify_player play-pause",
    "on-click-right": "playerctl -p spotify_player next",
    "on-click-middle": "playerctl -p spotify_player previous",
    "on-scroll-up": "playerctl -p spotify_player next",
    "on-scroll-down": "playerctl -p spotify_player previous"
  },

  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": true
  },

  "memory": {
    "format": "RAM {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },

  "temperature": {
    "format": "{temperatureC}C",
    "critical-threshold": 85,
    "tooltip": true
  },

  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "Wired",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },

  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{desc}"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% +",
    "format-plugged": "{capacity}% AC",
    "format-alt": "{time}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  }
}
